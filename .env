# ── OpenSearch cluster endpoints ──────────────────────────────────────────────
SOURCE_HOST=localhost
SOURCE_PORT=9200
TARGET_HOST=localhost
TARGET_PORT=9201

# Security is disabled on both clusters (DISABLE_SECURITY_PLUGIN=true in compose).
# Set to "true" only if you re-enable the security plugin.
SECURITY_ENABLED=false

SOURCE_USER=admin
SOURCE_PASS=admin
TARGET_USER=admin
TARGET_PASS=admin

# ── Index names ───────────────────────────────────────────────────────────────
# Mirrors production index name so the POC steps are 1-to-1 with prod runbook
SOURCE_INDEX=mmh-poc
TARGET_INDEX=mmh-poc
TARGET_INDEX_REINDEXED=mmh-poc-v2

# ── Snapshot / S3 ─────────────────────────────────────────────────────────────
SNAPSHOT_REPO_NAME=s3-repo
SNAPSHOT_NAME=mmh-poc-snapshot

# MinIO (local S3 emulator). In production replace these three with real AWS
# values; the scripts and docker-compose read the same variables.
S3_ENDPOINT=http://localhost:9000      # external (host → MinIO)
S3_ENDPOINT_INTERNAL=http://minio:9000 # internal (container → MinIO)
S3_BUCKET=opensearch-snapshots
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1                    # MinIO ignores region but boto3 needs one

# ── Shard settings ────────────────────────────────────────────────────────────
# Production source: 5 primary × 1 replica = 10 shards total  (~180 GiB, oversized)
# Production target: 20 primary × 1 replica = 40 shards total (right-sized)
# Local demo uses the same shard ratio so the reindex step is identical to prod.
SOURCE_SHARDS=5
SOURCE_REPLICAS=1
TARGET_SHARDS=30
TARGET_REPLICAS=1

# ── Dashboards ────────────────────────────────────────────────────────────────
SRC_DASHBOARDS_URL=http://localhost:5601
TGT_DASHBOARDS_URL=http://localhost:5602

# ── Java heap per role ────────────────────────────────────────────────────────
# Master nodes only maintain cluster state — 192m is sufficient.
# Data nodes hold shards — 256m keeps total Docker RAM under ~4.5 GiB.
# (Docker Desktop limit on this machine: 7.654 GiB)
MASTER_HEAP=192m
DATA_HEAP=256m
